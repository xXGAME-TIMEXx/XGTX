+++ b/src/xgtx_exchange/public_metrics.hpp
@@ -0,0 +1,21 @@
+#pragma once
+#include "engine.hpp"
+
+namespace xgtx_exchange {
+struct public_asset_metrics { amount holders=0,treasury_balance=0; };
+
+inline std::map<id,public_asset_metrics> public_metrics(const state& snapshot,const id& treasury){
+  std::map<id,public_asset_metrics> result;
+  for(const auto& asset:snapshot.assets)result.emplace(asset.first,public_asset_metrics{});
+  for(const auto& balance:snapshot.balances){
+    auto metric=result.find(balance.first.second);
+    if(metric==result.end())throw std::runtime_error("Balance references unknown asset");
+    if(balance.second){
+      if(metric->second.holders==std::numeric_limits<amount>::max())throw std::overflow_error("Holder count overflow");
+      ++metric->second.holders;
+    }
+    if(balance.first.first==treasury)metric->second.treasury_balance=balance.second;
+  }
+  return result;
+}
+}
